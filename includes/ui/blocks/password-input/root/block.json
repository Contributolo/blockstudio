{
	"$schema": "https://blockstudio.dev/schema/block",
	"name": "bsui/password-input",
	"title": "Password Input",
	"category": "design",
	"icon": "lock",
	"blockstudio": {
		"interactivity": {
			"enqueue": true
		},
		"attributes": [
			{
				"id": "name",
				"type": "text",
				"label": "Name"
			},
			{
				"id": "placeholder",
				"type": "text",
				"label": "Placeholder",
				"default": "Enter password"
			},
			{
				"id": "disabled",
				"type": "toggle",
				"label": "Disabled",
				"default": false
			},
			{
				"id": "nameAlt",
				"type": "text",
				"label": "Form Name (alt)"
			},
			{
				"id": "onChange",
				"type": "text",
				"hidden": true
			},
			{
				"id": "value",
				"type": "text"
			},
			{
				"id": "inputId",
				"type": "text",
				"label": "Input ID",
				"help": "ID of the password input, for a label's for attribute."
			},
			{
				"id": "ariaLabel",
				"type": "text",
				"label": "Accessible Label",
				"help": "Names the input when no visible label points to it."
			},
			{
				"id": "autocomplete",
				"type": "text",
				"label": "Autocomplete",
				"help": "For example current-password or new-password."
			}
		]
	}
}
