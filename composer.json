{
    "name": "blockstudio/blockstudio",
    "type": "wordpress-plugin",
    "description": "The block framework for WordPress.",
    "minimum-stability": "stable",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "dennis",
            "email": "dnnsjsk@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "yahnis-elsts/plugin-update-checker": "^5.6",
        "league/commonmark": "^2.7",
        "symfony/yaml": "^7.0",
        "storh/storh": "0.0.3",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "humbug/php-scoper": "^0.18.18",
        "tailwindphp/tailwindphp": "^1.0",
        "scssphp/scssphp": "^2.1",
        "matthiasmullie/minify": "^1.3",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.2",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "php-stubs/wp-cli-stubs": "^2.12"
    },
    "autoload": {
        "classmap": [
            "lib/"
        ],
        "files": [
            "lib/runtime-autoload.php",
            "lib/storh-autoload.php",
            "bootstrap.php"
        ]
    },
    "scripts": {
        "scope": "@php scripts/build-dependencies.php",
        "test:dependencies": "@php tests/distribution/dependencies.php",
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "test": "phpunit"
    },
    "extra": {
        "blockstudio-scoped-packages": [
            "yahnis-elsts/plugin-update-checker",
            "league/commonmark",
            "symfony/yaml"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
